# Normalize text files.
* text=auto

# Source code
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Config and documentation
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf

# Scripts
*.ps1 text eol=crlf
*.sh text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Images and binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.pdf binary
*.zip binary

# Database / generated artifacts
*.db binary
*.sqlite binary
